# ── MARK LVI — Git Ignore Specification ────────────────────────────────────────
# Clean first-run experience: all local secrets, user data, media, and caches are ignored.

# ── Secrets & Private Configuration ──────────────────────────────────────────
config/api_keys.json
config/dashboard_sessions.json
config/certs/
config/whatsapp_web/
**/token*.json
**/client_secret*.json
*credentials*.json
.env
.env.*

# ── Personal / User Data & Runtime Databases ──────────────────────────────────
data/
memory/long_term.json
memory/*.db
*.db
*.sqlite
*.sqlite3

# ── Developer Workspaces, Reports & Backups ────────────────────────────────────
artifacts/
backups/
reports/
scratch_test/
uploads/
downloads/
screenshots/
*.bak
*.tmp

# ── Media & Render Outputs ───────────────────────────────────────────────────
*.wav
*.mp3
*.mp4
*.avi
*.mov

# ── Python Build & Cache Artifacts ───────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/

# ── Virtual Environments ──────────────────────────────────────────────────────
.venv/
.venv*/
venv/
env/
ENV/

# ── Editors & Operating Systems ───────────────────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ── Runtime Logs ──────────────────────────────────────────────────────────────
*.log
logs/
